generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String       @id @default(cuid())
  phoneNumber    String       @unique
  createdAt      DateTime     @default(now())
  // Full KYC (ticket #12, ADR 0007) — required to become an Organizer, never
  // required just to join/deposit as a Member. Stubbed here: set instantly by
  // POST /auth/verify rather than a real verification flow, until the real
  // BaaS/UPI partner integration (ticket #14) wires up an actual KYC check.
  isVerified     Boolean      @default(false)
  // Freemium subscription (ticket #13, ADR 0011) — waives the per-Spend fee,
  // lifts the concurrent-Active-Pool cap, and unlocks cross-Pool analytics.
  // Stubbed: set instantly by POST /auth/subscribe, no real billing yet.
  isSubscribed   Boolean      @default(false)
  // Onboarding (CONTEXT.md, ADR 0012) — collected once, right after OTP
  // signup, before the person ever reaches Home. Null/false until then.
  name           String?
  email          String?
  dateOfBirth    DateTime?
  // Registered UPI ID (CONTEXT.md, ADR 0012) — the real refund/reimbursement
  // destination, replacing the old fake `${memberId}@fakebank` placeholder.
  upiId          String?
  avatarUrl      String?
  isOnboarded    Boolean      @default(false)
  organizedPools Pool[]
  memberships    Membership[]
  deposits       Deposit[]
  pendingDeposits PendingDeposit[]
  spends         Spend[]
  spendAttributions SpendAttribution[]
  reimbursements Reimbursement[]
  refunds        Refund[]
  refundVotes    RefundVote[]
  notifications  Notification[]
  invitations    Invitation[]
}

model Pool {
  id     String @id @default(cuid())
  name   String
  // "EQUAL_SPLIT" | "OPEN" | "CUSTOM_SPLIT" — string, not a Prisma enum, since the sqlite connector doesn't support enums.
  type   String
  // Required (and positive) for EQUAL_SPLIT, always null for OPEN and
  // CUSTOM_SPLIT — a Custom Split Pool's per-person amount lives on each
  // Invitation instead, since it's individually assigned (ADR 0016).
  perPersonAmountPaise Int?
  // "ACTIVE" | "LOCKED" | "CLOSED" | "EXPIRED"
  state       String   @default("ACTIVE")
  organizerId String
  organizer   User     @relation(fields: [organizerId], references: [id])
  createdAt   DateTime @default(now())
  // Six-digit code for manual Pool joining. An Invite Link is just this Pool's
  // id embedded in a deep link — no separate stored field needed for that.
  // Unused by Custom Split Pools, which join exclusively via Invitation.
  joinCode    String       @unique
  memberships    Membership[]
  deposits       Deposit[]
  pendingDeposits PendingDeposit[]
  spends         Spend[]
  spendAttributions SpendAttribution[]
  reimbursements Reimbursement[]
  refunds        Refund[]
  refundVotes    RefundVote[]
  notifications  Notification[]
  invitations    Invitation[]

  @@index([organizerId])
}

// A Custom Split Pool's join-and-pay mechanism (ADR 0016, CONTEXT.md): one
// Invitation per invitee, carrying the individually assigned amount they
// must pay in full before a Membership is created for them. The Organizer's
// own share (ticket #58) is a self-addressed Invitation created alongside
// the Pool, gating Pool creation until they pay it just like anyone else.
model Invitation {
  id            String @id @default(cuid())
  poolId        String
  pool          Pool   @relation(fields: [poolId], references: [id])
  inviteeUserId String
  invitee       User   @relation(fields: [inviteeUserId], references: [id])
  // In paise. Individually assigned by the Organizer — not shared with any
  // other Invitation on the same Pool, unlike Pool.perPersonAmountPaise.
  assignedAmountPaise Int
  // "PENDING" | "PAID" | "CANCELLED" | "EXPIRED"
  state         String    @default("PENDING")
  // Opaque token for the phone-bound Invitation link (ticket #61) — unused
  // by the self-addressed Invitation created at Pool creation (ticket #58).
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([poolId])
  @@index([poolId, inviteeUserId])
  // Backs listPendingByInvitee (ticket #60) — an invitee's own list of
  // Invitations still worth opening, across every Pool.
  @@index([inviteeUserId, state])
}

model Deposit {
  id     String @id @default(cuid())
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])
  // In paise. Never validated against the Pool's per-person amount — Equal
  // Split deposits arriving at a different amount are recorded, not rejected.
  amountPaise Int
  createdAt   DateTime @default(now())

  @@index([poolId])
  @@index([poolId, userId])
}

// Bookkeeping for confirming a deposit intent server-side, closing the gap
// where a real Payment Provider (ticket #14, #15) confirms payment via an
// async webhook rather than synchronously: created when the intent's QR is
// generated (so we know which Member it was for before any money moves),
// consumed exactly once — by whichever of self-report or webhook arrives
// first — so the two paths can't double-credit the same payment.
model PendingDeposit {
  id          String    @id @default(cuid())
  providerRef String    @unique
  poolId      String
  pool        Pool      @relation(fields: [poolId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  // The Deposit row created on first confirmation — kept so a repeat
  // confirmation (idempotent replay) can return the same result instead of
  // re-validating or re-crediting.
  resultingDepositId String?
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([poolId])
}

model Spend {
  id     String @id @default(cuid())
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])
  // The merchant's UPI reference the Organizer scanned/entered.
  merchantRef String
  // In paise. The per-Spend fee (ADR 0010) — Pool Pay's own monetization,
  // never applied to Deposits or Refunds.
  amountPaise Int
  feePaise    Int
  createdAt   DateTime @default(now())
  attributions SpendAttribution[]

  @@index([poolId])
}

// The actual, post-insolvency-sit-out split of one Spend's cost across the
// Members charged for it (ADR-0021): one row per Member actually charged,
// never assumed to be a clean equal division after the fact. Drives each
// Member's Your Remaining Balance (ADR-0022) alongside their Deposits.
model SpendAttribution {
  id     String @id @default(cuid())
  spendId String
  spend   Spend  @relation(fields: [spendId], references: [id])
  // Denormalized from Spend.poolId so a Member's balance can be summed
  // without joining through Spend for every query.
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])
  memberId String
  member   User   @relation(fields: [memberId], references: [id])
  // In paise. What this Member was actually charged for this Spend.
  amountPaise Int
  createdAt   DateTime @default(now())

  @@index([spendId])
  @@index([poolId, memberId])
}

model Reimbursement {
  id     String @id @default(cuid())
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])
  // The Member being paid back. Named memberId (not userId) since, unlike
  // Deposit/Spend, this row isn't about the actor (always the Organizer) —
  // it's about who received the money.
  memberId String
  member   User   @relation(fields: [memberId], references: [id])
  vpa      String
  // In paise. No fee — Reimbursements are never fee-bearing (ADR 0010).
  amountPaise Int
  createdAt   DateTime @default(now())

  @@index([poolId])
}

model Refund {
  id     String @id @default(cuid())
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])
  // The Member being refunded, paid their own remaining balance (see
  // closePool, ADR-0022) — not the Organizer, who initiates Closure but
  // isn't treated specially in the payout itself.
  memberId String
  member   User   @relation(fields: [memberId], references: [id])
  vpa      String
  // In paise. No fee — Refunds are never fee-bearing (ADR 0010).
  amountPaise Int
  createdAt   DateTime @default(now())

  @@index([poolId])
}

model RefundVote {
  id     String @id @default(cuid())
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // One vote per Member per Pool (ADR 0009) — casting again is a no-op, not
  // an additional vote.
  @@unique([poolId, userId])
  @@index([poolId])
}

model Membership {
  id     String @id @default(cuid())
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])
  // "ORGANIZER" | "MEMBER"
  role      String
  joinedAt  DateTime @default(now())
  // Set when the Organizer removes this Member (ticket #11). A removed
  // Membership row is kept (not deleted) purely as an audit trail — access
  // checks (find/listByPool) treat it as absent. Deposits reference userId
  // directly, so prior contributions still count at Closure regardless
  // (ADR 0006).
  removedAt DateTime?

  @@unique([poolId, userId])
}

// Alerts tab (ticket #23) — one row per recipient per event, so "every other
// current Member" fans out to N rows rather than one shared row with a
// per-user read state.
model Notification {
  id              String    @id @default(cuid())
  recipientUserId String
  recipient       User      @relation(fields: [recipientUserId], references: [id])
  poolId          String
  pool            Pool      @relation(fields: [poolId], references: [id])
  // "DEPOSIT_RECEIVED" | "POOL_FULLY_FUNDED" | "POOL_LOCKED" | "REFUND_PROCESSED"
  type            String
  message         String
  createdAt       DateTime  @default(now())
  readAt          DateTime?

  @@index([recipientUserId])
}

model OtpRequest {
  id          String    @id @default(cuid())
  phoneNumber String
  code        String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
}
