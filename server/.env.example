DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-secret-change-me"

# Cashfree (ADR 0013) — optional. Leave unset to run against the fakes
# (FakePaymentProvider / FakeIdentityProvider). Cashfree issues a separate
# client-id/secret pair per product (Payment Gateway, Payouts, Verification
# Suite are independent dashboard apps) — see server/src/lib/env.ts's
# hasCashfreePaymentCredentials / hasCashfreeIdentityCredentials for which
# vars gate which adapter.
# CASHFREE_ENV=sandbox
# CASHFREE_PG_CLIENT_ID=
# CASHFREE_PG_CLIENT_SECRET=
# CASHFREE_PAYOUT_CLIENT_ID=
# CASHFREE_PAYOUT_CLIENT_SECRET=
# CASHFREE_VERIFICATION_CLIENT_ID=
# CASHFREE_VERIFICATION_CLIENT_SECRET=
# CASHFREE_VIRTUAL_VPA=
# Secure ID's Public Key 2FA (docs.cashfree.com/secure-id) — only needed if
# the Verification Suite dashboard app has Public Key 2FA turned on; unset
# falls back to relying on IP whitelisting alone. Must be double-quoted with
# its real embedded newlines kept (dotenv only supports multiline values
# inside quotes — an unquoted PEM block silently truncates to just its first
# line, "-----BEGIN PUBLIC KEY-----", with the actual key body dropped):
# CASHFREE_VERIFICATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"
