DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-secret-change-me"

# Cashfree (ADR 0013) — optional. Leave unset to run against the fakes
# (FakePaymentProvider / FakeIdentityProvider). Cashfree issues a separate
# client-id/secret pair per product (Payment Gateway, Payouts, Verification
# Suite are independent dashboard apps) — see server/src/lib/env.ts's
# hasCashfreePaymentCredentials / hasCashfreeIdentityCredentials for which
# vars gate which adapter.
# CASHFREE_ENV=sandbox
# CASHFREE_PG_CLIENT_ID=
# CASHFREE_PG_CLIENT_SECRET=
# CASHFREE_PAYOUT_CLIENT_ID=
# CASHFREE_PAYOUT_CLIENT_SECRET=
# CASHFREE_VERIFICATION_CLIENT_ID=
# CASHFREE_VERIFICATION_CLIENT_SECRET=
# CASHFREE_VIRTUAL_VPA=
# Secure ID's Public Key 2FA method — alternative to IP whitelisting.
# Payouts and Verification Suite each enforce this independently and each
# have their own dashboard-issued key; without one or the other, Payouts'
# beneficiary/transfer calls fail with "Signature missing in the request".
# Leave unset to rely on IP whitelisting instead. Generate + download from
# the product's dashboard: Developers -> Two-Factor Authentication -> select
# "Public Key" -> Generate Public Key (the downloaded file is
# password-protected; the password is emailed to your account's registered
# address). Paste the PEM contents here with real newlines replaced by
# literal \n.
# CASHFREE_VERIFICATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
# CASHFREE_PAYOUT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
